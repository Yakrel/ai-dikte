+def install_hyprland_shortcut() -> None:
+    target, binding = hyprland_shortcut_target()
+    target.parent.mkdir(parents=True, exist_ok=True)
+
+    # Remove a block created by an older gemini-dikte version if the user's
+    # Hyprland configuration format changed (notably Omarchy 3 -> 4).
+    other = HYPR_BINDINGS_CONF if target == HYPR_BINDINGS_LUA else HYPR_BINDINGS_LUA
+    remove_managed_shortcut_block(other)
+
+    current = target.read_text(encoding="utf-8") if target.exists() else ""
+    if HYPR_MARKER_START not in current:
+        block = f"{HYPR_MARKER_START}\n{binding}\n{HYPR_MARKER_END}\n"
+        separator = "" if not current or current.endswith("\n") else "\n"
+        with target.open("a", encoding="utf-8") as handle:
+            handle.write(separator + block)
+        print(f"[OK] Installed Hyprland shortcut Meta+Z in {target}")
+    else:
+        print(f"[OK] Hyprland shortcut already installed in {target}")
+
+    reload_hyprland()
+
+
+def remove_hyprland_shortcut() -> None:
+    removed: list[Path] = []
+    for path in (HYPR_BINDINGS_LUA, HYPR_BINDINGS_CONF):
+        if remove_managed_shortcut_block(path):
+            removed.append(path)
+
+    if removed:
+        for path in removed:
+            print(f"[OK] Removed Hyprland shortcut from {path}")
+        reload_hyprland()
+    else:
+        print("[OK] No managed Gemini Dictation shortcut found.")
+
