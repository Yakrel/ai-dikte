                        ui_lang_menu.configure(values=[t(key) for _, key in ui_lang_choices])
                        ui_lang_menu.current(
                            next(
                                (
                                    index
                                    for index, (code, _key) in enumerate(ui_lang_choices)
                                    if code == current_ui_code[0]
                                ),
                                0,
                            )
                        )
                        dict_menu.configure(values=[t(key) for _, key in dict_choices])
                        dict_menu.current(
                            next(
                                index
                                for index, (code, _key) in enumerate(dict_choices)
                                if code == current_dict_code[0]
                            )
                        )
                        mode_menu.configure(values=[t(key) for _, key in mode_choices])
                        mode_menu.current(
