                    index = mode_menu.current()
                    if index >= 0:
                        current_mode_code[0] = mode_choices[index][0]
                        mark_changed()

                def select_notify(_event: Any = None) -> None:
                    index = notify_menu.current()
                    if index >= 0:
                        current_notify_code[0] = notify_choices[index][0]
                        mark_changed()

                def select_microphone(_event: Any = None) -> None:
                    selected_device_value[0] = mic_device_by_label.get(microphone_var.get())
                    mark_changed()

                def validation_worker(
                    key: str,
                    candidate: dict[str, Any],
                    startup_enabled: bool,
                ) -> None:
                    try:
                        validate_api_key(key, candidate)
                        save_setup_config(key, candidate)
                    except Exception as exc:
                        result_queue.put(("error", str(exc)))
                        return
                    try:
                        set_windows_startup_enabled(startup_enabled)
                    except Exception as exc:
                        result_queue.put(("partial", str(exc)))
                        return
                    result_queue.put(("success", ""))

                def poll_validation() -> None:
                    try:
                        result, message = result_queue.get_nowait()
                    except queue.Empty:
                        if state["validating"]:
                            root.after(100, poll_validation)
                        return

                    state["validating"] = False
                    if result == "error":
                        state["status_kind"] = "error"
                        state["error_msg"] = message
                        save_button.configure(state="normal", text=t("btn_save"))
                        close_button.configure(state="normal", text=t("btn_cancel"))
                        update_status_display()
                        return

                    state["dirty"] = False
                    if result == "partial":
                        state["status_kind"] = "error"
                        state["error_msg"] = f"{t('status_success')} ({message})"
                    else:
                        state["status_kind"] = "success"
                    save_button.configure(state="disabled", text=t("btn_save"))
                    close_button.configure(state="normal", text=t("btn_close"))
                    update_status_display()

                def save_settings() -> None:
                    if state["validating"]:
                        return
                    key = key_entry.get().strip() or old_key
                    if not key:
                        state["status_kind"] = "error"
                        state["error_msg"] = t("status_empty_key")
                        update_status_display()
                        key_entry.focus_set()
                        return

                    updates = {
                        "ui_language": current_ui_code[0],
                        "language": get_effective_dictation_lang(),
                        "mode": current_mode_code[0],
                        "custom_vocabulary": vocabulary_text.get("1.0", tk.END).splitlines(),
                        "notify_mode": current_notify_code[0],
                        "audio_cue": bool(audio_cue_var.get()),
                        "input_device": selected_device_value[0],
                    }
                    try:
                        candidate = build_setup_config(existing, updates)
                    except Exception as exc:
                        state["status_kind"] = "error"
                        state["error_msg"] = str(exc)
                        update_status_display()
                        return

                    state["validating"] = True
                    state["status_kind"] = "validating"
                    state["error_msg"] = ""
                    update_status_display()
                    save_button.configure(state="disabled", text=t("btn_validating"))
                    close_button.configure(state="disabled")
                    threading.Thread(
                        target=validation_worker,
                        args=(key, candidate, bool(startup_var.get())),
                        daemon=True,
                    ).start()
                    root.after(100, poll_validation)

                save_button = tk.Button(
                    footer,
                    text=t("btn_save"),
                    command=save_settings,
                    bg=accent,
                    fg="white",
                    activebackground=accent_hover,
                    activeforeground="white",
                    disabledforeground="#a5b4fc",
                    relief="flat",
                    borderwidth=0,
                    font=("Segoe UI Semibold", 9),
                    padx=18,
                    pady=9,
                    cursor="hand2",
                )
                save_button.grid(row=0, column=3, rowspan=2, padx=(0, 13), pady=13)

                ui_lang_menu.bind("<<ComboboxSelected>>", select_ui_lang)
                dict_menu.bind("<<ComboboxSelected>>", select_dict_lang)
                mode_menu.bind("<<ComboboxSelected>>", select_mode)
                notify_menu.bind("<<ComboboxSelected>>", select_notify)
                mic_menu.bind("<<ComboboxSelected>>", select_microphone)
                key_entry.bind("<KeyRelease>", mark_changed)
                custom_lang_entry.bind("<KeyRelease>", mark_changed)
                vocabulary_text.bind("<KeyRelease>", mark_changed)
                audio_cue_var.trace_add("write", mark_changed)
                startup_var.trace_add("write", mark_changed)

                refresh_ui_texts()
                root.protocol("WM_DELETE_WINDOW", request_close)
                root.bind("<Escape>", lambda _event: request_close())
                root.bind("<Control-Return>", lambda _event: save_settings())
                show_window(t("settings_title"), 920, 780, min_width=760, min_height=620)
                root.after(80, key_entry.focus_force)
                root.mainloop()
                return

            if subcmd == "doctor":
                report, failed = doctor_report()
                ui_lang = resolve_ui_language(load_config_best_effort())
                show_report(get_translation(ui_lang, "doctor_title"), report, warning=failed)
                return

            show_report(
                "AI Dikte",
                f"Unsupported tray command: {subcmd}",
                warning=True,
            )
    except SystemExit:
        ui_lang = resolve_ui_language(load_config_best_effort())
        msg = (
            "Başka bir AI Dikte komutu zaten çalışıyor."
            if ui_lang == "tr"
            else "Another AI Dikte command is already running."
        )
        show_report("AI Dikte", msg, warning=True)
    except Exception as exc:
        show_report("AI Dikte", str(exc), warning=True)
    finally:
        try:
            root.destroy()
        except tk.TclError:
            pass


def run_daemon() -> None:
    """Run in background with global hotkey and system tray icon."""
    global _GLOBAL_TRAY_ICON
    hide_private_windows_console()


    config = load_config()
    hotkey = config_hotkey(config)

    print("[*] Starting AI Dikte daemon...")
    print(f"[*] Dictation hotkey: {hotkey}")

    if IS_WINDOWS:
        setup_windows_keyboard_hook(toggle)
        print("[OK] Global Windows hook registered for: Win+Z")
    else:
        try:
            import keyboard

            keyboard.add_hotkey(hotkey, toggle)
            print(f"[OK] Global hotkey '{hotkey}' registered.")
        except Exception as exc:
            fail(f"Could not register hotkey '{hotkey}': {exc}")

    tray_children: dict[str, subprocess.Popen] = {}

    try:
        from PIL import Image, ImageDraw
        import pystray

        def render_tray_icon(bg_color: str, symbol: str = "mic") -> Image.Image:
            s = 128
            img = Image.new("RGBA", (s, s), (0, 0, 0, 0))
            draw = ImageDraw.Draw(img)
            margin = 4
            draw.ellipse([(margin, margin), (s - margin, s - margin)], fill=bg_color)

            cx, cy = s // 2, s // 2 - 4
            cw, ch = 24, 44
            cr = cw // 2
            cbox = [(cx - cr, cy - ch // 2), (cx + cr, cy + ch // 2)]
            draw.rounded_rectangle(cbox, radius=cr, fill=(255, 255, 255, 255))

            arc_r = cr + 9
            cradle_top = cy - 6
            draw.arc(
                [(cx - arc_r, cradle_top - arc_r), (cx + arc_r, cradle_top + arc_r)],
                start=0,
                end=180,
                fill=(255, 255, 255, 255),
                width=5,
            )

            stem_top = cradle_top + arc_r
            stem_bot = stem_top + 16
            draw.line([(cx, stem_top), (cx, stem_bot)], fill=(255, 255, 255, 255), width=5)
            draw.line([(cx - 18, stem_bot), (cx + 18, stem_bot)], fill=(255, 255, 255, 255), width=5)

            if symbol == "sparkle":
                sx, sy, sz = cx + 26, cy - 20, 10
                pts = [
                    (sx, sy - sz),
                    (sx + sz * 0.3, sy - sz * 0.3),
                    (sx + sz, sy),
                    (sx + sz * 0.3, sy + sz * 0.3),
                    (sx, sy + sz),
                    (sx - sz * 0.3, sy + sz * 0.3),
                    (sx - sz, sy),
                    (sx - sz * 0.3, sy - sz * 0.3),
                ]
                draw.polygon(pts, fill=(255, 255, 255, 255))
            elif symbol == "recording":
                rx, ry = cx + 26, cy - 20
                draw.ellipse([(rx - 7, ry - 7), (rx + 7, ry + 7)], fill=(255, 255, 255, 255))

            return img.resize((64, 64), Image.Resampling.LANCZOS)

        images = {
            "blue": render_tray_icon("#4f46e5", "mic"),
            "red": render_tray_icon("#ef4444", "recording"),
            "yellow": render_tray_icon("#eab308", "sparkle"),
            "gray": render_tray_icon("#6b7280", "mic"),
        }

        def on_toggle_clicked(icon, item):
            toggle()

        def on_exit_clicked(icon, item):
            icon.stop()

        def on_open_logs_clicked(icon, item):
            try:
                open_session_log()
            except OSError as exc:
                notify("AI Dikte", str(exc), "critical", event_type="error")

        def on_copy_diagnostics_clicked(icon, item):
            try:
                copy_doctor_report()
                ui_lang = resolve_ui_language(load_config_best_effort())
                msg = (
                    "Tanılama bilgileri panoya kopyalandı."
                    if ui_lang == "tr"
                    else "Diagnostics copied to clipboard."
                )
                notify("AI Dikte", msg)
            except Exception as exc:
                notify("AI Dikte", str(exc), "critical", event_type="error")

        def on_startup_clicked(icon, item):
            try:
                new_state = not windows_startup_enabled()
                set_windows_startup_enabled(new_state)
                icon.update_menu()
                ui_lang = resolve_ui_language(load_config_best_effort())
                if ui_lang == "tr":
                    msg = (
