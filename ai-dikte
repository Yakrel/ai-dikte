                        state["updating"] = False

                def select_ui_lang(_event: Any = None) -> None:
                    index = ui_lang_menu.current()
                    if index < 0:
                        return
                    current_ui_code[0] = ui_lang_choices[index][0]
                    current_ui_lang[0] = resolve_ui_language(
                        {
                            "ui_language": current_ui_code[0],
                            "language": get_effective_dictation_lang(),
