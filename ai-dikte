                            "section_account": "section_account_help",
                            "section_language": "section_language_help",
                            "section_audio": "section_audio_help",
                            "section_behavior": "section_behavior_help",
                            "section_vocabulary": "section_vocabulary_help",
                        }
                        for key, (title_label, description_label) in section_texts.items():
                            title_label.configure(text=t(key))
                            description_label.configure(text=t(help_keys[key]))
                        for key, label in field_labels.items():
                            label.configure(text=t(key))
                        api_help.configure(text=t("api_key_help"))
                        custom_lang_help.configure(text=t("custom_lang_placeholder"))
                        vocab_help.configure(text=t("vocabulary_help"))
                        audio_cue_cb.configure(text=t("audio_cue_label"))
                        startup_cb.configure(text=t("startup_label"))
                        shortcut_label.configure(text=t("save_shortcut"))
