#!/usr/bin/env python3
"""Minimal NixOS/KDE Wayland dictation using Gemini REST API."""

from __future__ import annotations

import base64
import fcntl
import getpass
import json
import os
import shutil
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any

APP = "gemini-dikte"
HOME = Path.home()
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / APP
CONFIG_FILE = CONFIG_DIR / "config.json"
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", f"/tmp/{APP}-{os.getuid()}")) / APP
PID_FILE = RUNTIME_DIR / "recording.pid"
AUDIO_FILE = RUNTIME_DIR / "recording.wav"
ERROR_FILE = RUNTIME_DIR / "pw-record.stderr"
LOCK_FILE = RUNTIME_DIR / "command.lock"

CLEAN_DICTATION_PROMPT = (
    "You are a professional dictation transcription and cleanup engine. "
    "Transcribe the attached audio accurately in the specified language, then "
    "convert the spoken language into clean, natural, well-written text. "
    "Preserve the speaker's exact meaning, intent, and tone. Correct punctuation, "
    "capitalization, spelling, and grammar. Fix obvious speech-recognition mistakes "
    "when the intended word is clear from context. Remove filler words, hesitation "
    "sounds, stutters, accidental repetitions, and abandoned sentence fragments. "
    "Turn fragmented, awkward, or inverted spoken sentences into natural written "
    "sentences, and merge unnecessarily broken phrases when they clearly belong "
    "together. Keep names, numbers, technical terms, commands, file paths, URLs, "
    "product names, and abbreviations accurate. Do not summarize or shorten meaningful "
    "information. Do not add facts, explanations, opinions, or answers. If the speaker "
    "asks a question, transcribe the question; do not answer it. If the speaker dictates "
    "punctuation or formatting, apply it naturally instead of writing the instruction "
    "literally. Prefer clear and concise written language without changing the intended "
    "meaning. Return only the final cleaned text, with no quotation marks, Markdown, "
    "headings, or introductory text."
)

DEFAULT_CONFIG: dict[str, Any] = {
    "api_key": "",
    "model": "gemini-3.5-flash-lite",
    "language": "tr-TR",
    "auto_paste": True,
    "notifications": True,
    "prompt": CLEAN_DICTATION_PROMPT,
}


def ensure_runtime() -> None:
    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
    RUNTIME_DIR.chmod(0o700)


def load_config(required: bool = True) -> dict[str, Any]:
    if not CONFIG_FILE.exists():
        if required:
            fail("Configuration missing. Run 'gemini-dikte setup'.")
        return DEFAULT_CONFIG.copy()
    try:
        loaded = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        if required:
            fail(f"Could not read config: {exc}")
        return DEFAULT_CONFIG.copy()
    config = DEFAULT_CONFIG.copy()
    config.update(loaded)
    return config


def notify(title: str, message: str, urgency: str = "normal") -> None:
    if not load_config(required=False).get("notifications", True):
        return
    command = shutil.which("notify-send")
    if command:
        subprocess.run(
            [command, "-a", "Gemini Dictation", "-u", urgency, title, message],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )


def fail(message: str, code: int = 1) -> None:
    notify("Gemini Dictation — Error", message, "critical")
    print(f"[ERROR] {message}", file=sys.stderr)
    raise SystemExit(code)


def setup() -> None:
    current = load_config(required=False)
    key = getpass.getpass("Google AI API key: ").strip() or str(current.get("api_key", "")).strip()
    if not key:
        fail("API key cannot be empty.")

    model_default = str(current.get("model") or DEFAULT_CONFIG["model"])
    language_default = str(current.get("language") or DEFAULT_CONFIG["language"])
    model = input(f"Model [{model_default}]: ").strip() or model_default
    language = input(f"Language [{language_default}]: ").strip() or language_default

    current.update({"api_key": key, "model": model, "language": language})
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(current, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    CONFIG_FILE.chmod(0o600)
    print(f"[OK] Saved: {CONFIG_FILE}")


def read_pid() -> int | None:
    try:
        return int(PID_FILE.read_text(encoding="ascii").strip())
    except (OSError, ValueError):
        PID_FILE.unlink(missing_ok=True)
        return None


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False


def start_recording() -> None:
    load_config()
    ensure_runtime()

    pid = read_pid()
    if pid and pid_alive(pid):
        fail("Recording is already in progress.")

    recorder = shutil.which("pw-record")
    if not recorder:
        fail("pw-record not found. PipeWire must be enabled in NixOS.")

    AUDIO_FILE.unlink(missing_ok=True)
    ERROR_FILE.unlink(missing_ok=True)
    with ERROR_FILE.open("wb") as error_handle:
        process = subprocess.Popen(
            [recorder, "--rate=16000", "--channels=1", "--format=s16", str(AUDIO_FILE)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=error_handle,
            start_new_session=True,
        )

    time.sleep(0.25)
    if process.poll() is not None:
        details = ERROR_FILE.read_text(errors="replace")[-500:] if ERROR_FILE.exists() else ""
        fail(f"Could not start recording. {details.strip()}")

    PID_FILE.write_text(str(process.pid), encoding="ascii")
    PID_FILE.chmod(0o600)
    notify("Gemini Dictation", "Recording started")


def terminate_recorder(pid: int) -> None:
    try:
        os.killpg(pid, signal.SIGINT)
    except (ProcessLookupError, PermissionError):
        try:
            os.kill(pid, signal.SIGINT)
        except (ProcessLookupError, PermissionError):
            return

    deadline = time.monotonic() + 4.0
    while time.monotonic() < deadline:
        if not pid_alive(pid):
            return
        time.sleep(0.1)

    try:
        os.killpg(pid, signal.SIGTERM)
    except (ProcessLookupError, PermissionError):
        pass


def extract_text(response: dict[str, Any]) -> str:
    try:
        parts = response["candidates"][0]["content"]["parts"]
        text = "".join(str(part.get("text", "")) for part in parts).strip()
    except (KeyError, IndexError, TypeError) as exc:
        raise RuntimeError(f"No text in Gemini response: {response}") from exc

    if text.startswith("```") and text.endswith("```"):
        lines = text.splitlines()
        if len(lines) >= 3:
            text = "\n".join(lines[1:-1]).strip()
    return text


def transcribe(config: dict[str, Any]) -> str:
    audio = AUDIO_FILE.read_bytes()
    if len(audio) < 1000:
        raise RuntimeError("Audio recording is empty or too short.")
    if len(audio) > 18 * 1024 * 1024:
        raise RuntimeError("Recording exceeds 18 MB; make a shorter recording.")

    model = urllib.parse.quote(str(config["model"]), safe="-._")
    endpoint = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent"
    payload = {
        "system_instruction": {"parts": [{"text": str(config.get("prompt", CLEAN_DICTATION_PROMPT))}]},
        "contents": [{
            "role": "user",
            "parts": [
                {"text": f"Spoken language: {config.get('language', 'tr-TR')}. Transcribe and clean up this dictation."},
                {"inlineData": {"mimeType": "audio/wav", "data": base64.b64encode(audio).decode("ascii")}},
            ],
        }],
        "generationConfig": {"maxOutputTokens": 8192},
    }
    request = urllib.request.Request(
        endpoint,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json", "x-goog-api-key": str(config["api_key"])},
        method="POST",
    )

    try:
        with urllib.request.urlopen(request, timeout=75) as result:
            return extract_text(json.loads(result.read().decode("utf-8")))
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        try:
            detail = json.loads(body).get("error", {}).get("message", body)
        except json.JSONDecodeError:
            detail = body
        raise RuntimeError(f"Gemini HTTP {exc.code}: {detail}") from exc
    except urllib.error.URLError as exc:
        raise RuntimeError(f"Gemini connection error: {exc.reason}") from exc
    except TimeoutError as exc:
        raise RuntimeError("Gemini request timed out.") from exc


def copy_and_paste(text: str, auto_paste: bool) -> str:
    if not os.environ.get("WAYLAND_DISPLAY"):
        raise RuntimeError("A Wayland session is required.")

    clipboard = shutil.which("wl-copy")
    if not clipboard:
        raise RuntimeError("wl-copy not found.")
    subprocess.run([clipboard], input=text, text=True, check=True)

    ydotool = shutil.which("ydotool")
    if auto_paste and ydotool:
        time.sleep(0.15)
        result = subprocess.run(
            [ydotool, "key", "29:1", "47:1", "47:0", "29:0"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if result.returncode == 0:
            return "pasted"
    return "copied"


def stop_recording(cancel: bool = False) -> None:
    pid = read_pid()
    if not pid:
        fail("No active recording.")

    terminate_recorder(pid)
    PID_FILE.unlink(missing_ok=True)
    time.sleep(0.2)

    if cancel:
        AUDIO_FILE.unlink(missing_ok=True)
        ERROR_FILE.unlink(missing_ok=True)
        notify("Gemini Dictation", "Recording cancelled")
        return

    notify("Gemini Dictation", "Transcribing…")
    try:
        text = transcribe(load_config())
        if not text:
            raise RuntimeError("Gemini returned empty text.")
        action = copy_and_paste(text, bool(load_config().get("auto_paste", True)))
        notify("Gemini Dictation", "Text pasted" if action == "pasted" else "Text copied")
        print(text)
    finally:
        AUDIO_FILE.unlink(missing_ok=True)
        ERROR_FILE.unlink(missing_ok=True)


def status() -> None:
    pid = read_pid()
    if pid and pid_alive(pid):
        print("recording")
        return
    PID_FILE.unlink(missing_ok=True)
    print("idle")


def doctor() -> None:
    config = load_config(required=False)
    checks = {
        "wayland": bool(os.environ.get("WAYLAND_DISPLAY")),
        "pw-record": bool(shutil.which("pw-record")),
        "wl-copy": bool(shutil.which("wl-copy")),
        "ydotool": bool(shutil.which("ydotool")),
        "notify-send": bool(shutil.which("notify-send")),
        "config": CONFIG_FILE.exists(),
        "api-key": bool(config.get("api_key")),
    }
    for name, ok in checks.items():
        print(f"{'✓' if ok else '✗'} {name}")
    if not all(checks.values()):
        raise SystemExit(1)


def toggle() -> None:
    pid = read_pid()
    if pid and pid_alive(pid):
        stop_recording()
    else:
        PID_FILE.unlink(missing_ok=True)
        start_recording()


def main() -> None:
    ensure_runtime()
    command = sys.argv[1] if len(sys.argv) > 1 else "toggle"

    with LOCK_FILE.open("a+") as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            fail("Previous operation is still running.")

        commands = {
            "setup": setup,
            "toggle": toggle,
            "start": start_recording,
            "stop": stop_recording,
            "cancel": lambda: stop_recording(cancel=True),
            "status": status,
            "doctor": doctor,
            "config-path": lambda: print(CONFIG_FILE),
        }
        action = commands.get(command)
        if action is None:
            print("Usage: gemini-dikte {setup|toggle|start|stop|cancel|status|doctor|config-path}")
            raise SystemExit(2)
        action()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        fail("Operation cancelled.", 130)
    except subprocess.CalledProcessError as exc:
        fail(f"External command failed: {exc}")
    except Exception as exc:
        fail(str(exc))
